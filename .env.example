# Copy to .env.local. For local dev, `npm run db:start` prints these values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose to the browser.
SUPABASE_SECRET_KEY=
# Production: use the Supabase transaction pooler URL (port 6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:56422/postgres
# API key for transcription and call analysis. Server only. OpenAI by default (platform.openai.com).
AI_API_KEY=
# Any OpenAI-compatible API. Default: https://api.openai.com/v1. For Groq, set:
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_TRANSCRIPTION_MODEL=whisper-large-v3
#   AI_CHAT_MODEL=openai/gpt-oss-120b
#   AI_CHAT_FALLBACK_MODEL=openai/gpt-oss-20b
#   AI_CHAT_FAST_MODEL=openai/gpt-oss-20b
# AI_BASE_URL=
# Optional model overrides. Defaults: whisper-1 (needs segment timestamps) and gpt-5.5.
# AI_TRANSCRIPTION_MODEL=
# AI_CHAT_MODEL=
# Used when the chat model hits a usage limit. Default: gpt-5.4-mini. Set it empty to turn the fallback off.
# AI_CHAT_FALLBACK_MODEL=
# For the simpler, high-volume jobs (speaker labels, coaching, sentiment). Default: gpt-5.4-mini.
# Scoring and call analysis always use AI_CHAT_MODEL. Set it empty to use AI_CHAT_MODEL for everything.
# AI_CHAT_FAST_MODEL=
