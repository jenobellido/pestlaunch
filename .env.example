# Copy to .env.local. For local dev, `npm run db:start` prints these values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose to the browser.
SUPABASE_SECRET_KEY=
# Production: use the Supabase transaction pooler URL (port 6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:56422/postgres
# API key for transcription and call analysis. Server only. Groq by default (console.groq.com).
AI_API_KEY=
# To use OpenAI instead, set:
#   AI_BASE_URL=https://api.openai.com/v1
#   AI_TRANSCRIPTION_MODEL=whisper-1   (needs timestamps, so not gpt-4o-transcribe)
#   AI_CHAT_MODEL=gpt-5-mini
#   AI_CHAT_FALLBACK_MODEL=
# AI_BASE_URL=
# Optional model overrides. Defaults: whisper-large-v3 and openai/gpt-oss-120b.
# AI_TRANSCRIPTION_MODEL=
# AI_CHAT_MODEL=
# Used when the chat model hits a usage limit (e.g. Groq's free daily tokens).
# Default: openai/gpt-oss-20b. Set it empty to turn the fallback off.
# AI_CHAT_FALLBACK_MODEL=
